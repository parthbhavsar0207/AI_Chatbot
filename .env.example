# ==============================================================================
# LPU CSE-AIML RAG Chatbot - Environment Configuration
# ==============================================================================

# Application Settings
APP_NAME="LPU CSE-AIML RAG Chatbot Backend"
APP_ENV="development"
APP_VERSION="0.1.0"
API_HOST="0.0.0.0"
API_PORT=8000
DEBUG=True

# Google Gemini API Settings (LLM Generation)
# Obtain your API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-2.5-flash"

# Embedding Settings (Local FastEmbed)
EMBEDDING_MODEL="BAAI/bge-small-en-v1.5"

# ChromaDB Persistent Storage Path
CHROMA_PERSIST_DIR="data/processed/chroma"

# Retrieval & Grounding Thresholds
SIMILARITY_THRESHOLD=0.65
TOP_K_RESULTS=4
