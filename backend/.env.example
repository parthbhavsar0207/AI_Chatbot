# ==============================================================================
# LPU CSE-AIML RAG Chatbot - Backend Environment Configuration
# ==============================================================================

# Application Settings
APP_NAME="LPU CSE-AIML RAG Chatbot Backend"
APP_ENV="development"
APP_VERSION="0.1.0"
API_HOST="0.0.0.0"
API_PORT=8000
DEBUG=True

# CORS Allowed Origins (comma-separated)
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174"

# LLM Provider Configuration
# Choose "ollama" for local GPU inference or "gemini" for Google AI Studio API
LLM_PROVIDER="ollama"

# Google Gemini API Settings (Free Tier - Phase 11)
# GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.1-flash-lite"
GEMINI_TIMEOUT_SECONDS=30.0
GEMINI_MAX_CONCURRENCY=2
GEMINI_FALLBACK_TO_LOCAL=True
